#!/usr/bin/env python3
"""Pick this session's plugins, MCP servers and model, then start Claude Code.

    claude-loadout --loadout [claude args...]

Plugins load at startup and no hook can change them once a session runs, so
the choice has to be made BEFORE `claude` starts. This asks, then execs the
real `claude` with the answer:

  plugins  -> --settings '{"enabledPlugins": {...}}'   (a flag setting beats
              user settings: verified, jev-hooks logged "enabled=false; will
              NOT register" under it)
  model    -> --model <alias>
  MCP      -> nothing when every server stays on; otherwise --strict-mcp-config
              plus a 0600 file listing the kept servers. Strict mode starts ONLY
              what is listed, and the claude.ai connectors cannot be listed -
              they are proxied through the account - so turning any local server
              off drops them for the session. The screen says so first.

A one-line task description is optional. Given one, and a TYPESAFE_API_KEY,
Jev pre-selects the model (the same criteria the subagent router uses) and may
tick a plugin that is normally off when the task clearly needs it. It never
unticks anything: a safety hook should not vanish because a task description
did not mention it.

Off by default: only `claude-loadout --loadout` asks (the --loadout flag is
consumed, never passed to claude). Without it, or with a subcommand, -p,
--resume/--continue, --help/--version or no terminal, claude starts exactly as
it would have. Cancelling any screen starts Claude with your normal defaults -
this never stands between you and a session.

jev-hooks is one plugin to Claude Code, but its hooks can be switched off one
by one: when it is ticked, a further screen lists each hook, and the unticked
ones reach the session as JEV_HOOKS_DISABLE, which every hook honours.

Scripting and tests (no UI):
    claude-loadout --dry-run --yes [--task T] [--pick-plugins a,b] [--pick-hooks h1,h2]
                   [--pick-mcp x,y] [--pick-model m] [args]
prints the argv it would exec, as JSON.
"""
import json, os, shutil, subprocess, sys, tempfile, time

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "lib"))

HOME = os.environ.get("CLAUDE_LOADOUT_HOME") or os.path.expanduser("~")
CLAUDE_DIR = os.path.join(HOME, ".claude")

# Subcommands and flags that mean "not an interactive session start".
PASSTHROUGH_WORDS = {"plugin", "plugins", "mcp", "config", "update", "doctor", "install", "migrate-installer",
                     "setup-token", "auth", "login", "logout", "agents", "api-key", "help"}
PASSTHROUGH_FLAGS = {"-p", "--print", "-r", "--resume", "-c", "--continue", "-h", "--help", "-v", "--version",
                     "--settings", "--model", "--mcp-config", "--strict-mcp-config", "--output-format",
                     "--input-format", "--from-pr", "--teleport"}
MODEL_CHOICES = ["opus", "opus[1m]", "fable", "sonnet", "haiku"]
CONNECTORS = "claude.ai connectors"
JEV_HOOKS_ID = "jev-hooks@jev-hooks"


def load(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default


def should_interview(argv, asked, tty=None):
    """Only when asked for with --loadout, and only at a terminal. Off by
    default: a plain `claude` is never interviewed and never slowed."""
    if not asked:
        return False
    if tty is None:
        tty = sys.stdin.isatty() and sys.stdout.isatty()
    if not tty:
        return False
    if argv and argv[0] in PASSTHROUGH_WORDS:
        return False
    return not any(a.split("=", 1)[0] in PASSTHROUGH_FLAGS for a in argv)


def ancestors(cwd):
    """cwd and every parent up to /, nearest first."""
    out, d = [], os.path.abspath(cwd)
    while True:
        out.append(d)
        up = os.path.dirname(d)
        if up == d:
            return out
        d = up


def plugins(cwd):
    """[(id, description, on_by_default)] for every installed plugin. The
    default is what a plain `claude` here would load: user settings, then
    project and local settings from the farthest ancestor to the nearest."""
    installed = (load(os.path.join(CLAUDE_DIR, "plugins", "installed_plugins.json"), {}) or {}).get("plugins") or {}
    enabled = dict((load(os.path.join(CLAUDE_DIR, "settings.json"), {}) or {}).get("enabledPlugins") or {})
    for d in reversed(ancestors(cwd)):
        if d == HOME:
            continue                 # ~/.claude/settings.json is the USER file, already read
        for name in ("settings.json", "settings.local.json"):
            enabled.update((load(os.path.join(d, ".claude", name), {}) or {}).get("enabledPlugins") or {})
    out = []
    for pid, versions in sorted(installed.items()):
        path = (versions or [{}])[0].get("installPath") or ""
        desc = (load(os.path.join(path, ".claude-plugin", "plugin.json"), {}) or {}).get("description") or ""
        out.append((pid, desc, bool(enabled.get(pid, False))))
    return out


def mcp_servers(cwd):
    """{name: config} Claude Code would start here from local config: user scope
    in ~/.claude.json, that file's per-project entries for cwd and its parents,
    and .mcp.json files. Plugin-provided servers follow their plugin's toggle."""
    cfg = load(os.path.join(HOME, ".claude.json"), {}) or {}
    servers = dict(cfg.get("mcpServers") or {})
    projects = cfg.get("projects") or {}
    for d in reversed(ancestors(cwd)):
        servers.update((projects.get(d) or {}).get("mcpServers") or {})
        servers.update((load(os.path.join(d, ".mcp.json"), {}) or {}).get("mcpServers") or {})
    return servers


def plugin_servers(pid):
    """The MCP servers an installed plugin declares - in .claude-plugin/plugin.json
    (inline, or a path to a JSON file) or a root .mcp.json - with
    ${CLAUDE_PLUGIN_ROOT} resolved. Strict mode starts only what the file lists,
    and that drops plugin servers too (verified: chrome-devtools enabled, its
    server never started), so a kept plugin's servers are copied in."""
    installed = (load(os.path.join(CLAUDE_DIR, "plugins", "installed_plugins.json"), {}) or {}).get("plugins") or {}
    root = ((installed.get(pid) or [{}])[0]).get("installPath") or ""
    if not root:
        return {}
    decl = (load(os.path.join(root, ".claude-plugin", "plugin.json"), {}) or {}).get("mcpServers")
    if isinstance(decl, str):
        decl = (load(os.path.join(root, decl), {}) or {}).get("mcpServers", load(os.path.join(root, decl), {}))
    if not isinstance(decl, dict):
        decl = (load(os.path.join(root, ".mcp.json"), {}) or {}).get("mcpServers") or {}
    text = json.dumps(decl).replace("${CLAUDE_PLUGIN_ROOT}", root)
    return json.loads(text) if isinstance(decl, dict) else {}


def default_model():
    return (load(os.path.join(CLAUDE_DIR, "settings.json"), {}) or {}).get("model") or "default"


def preselect(task, plugin_list):
    """Jev's picks for a task: a model alias or None, and the ids of plugins that
    are normally OFF but the task clearly needs. Never raises; None/[] when the
    judge is unavailable."""
    if not task.strip() or not os.environ.get("TYPESAFE_API_KEY"):
        return None, []
    try:
        import jev, models
    except Exception:
        return None, []
    off = [(pid, desc) for pid, desc, on in plugin_list if not on]
    q = {"model": jev.choice(
        "Which model should do `task`? Judge the WORK it asks for, not how long the text is.",
        {m: models.CRITERIA[m] for m in ("opus", "fable", "sonnet", "haiku")})}
    for i, (pid, desc) in enumerate(off):
        q[f"p{i}"] = jev.noul(f"Would `task` clearly USE the plugin `{pid}`: {desc[:300]}?",
                              true="the task is squarely what this plugin exists for",
                              false="the task is unrelated, or would only possibly touch it")
    a = jev.ask({"task": task[:2000]}, q, retries=0, timeout=4)
    if not a:
        return None, []
    pick = models.choose(models.probabilities(a.get("model")), ["opus", "fable", "sonnet", "haiku"], 0.5, 1.1)
    add = [pid for i, (pid, _) in enumerate(off) if float((a.get(f"p{i}") or {}).get("noul") or 0) >= 0.7]
    return pick, add


def build_argv(argv, plugin_list, chosen_plugins, servers, chosen_mcp, keep_connectors, model, runtime_dir):
    """The claude argv for a loadout. Flags only where the choice differs from
    what a plain `claude` would do anyway."""
    out = ["claude"]
    if any((pid in chosen_plugins) != on for pid, _, on in plugin_list):
        out += ["--settings", json.dumps({"enabledPlugins": {pid: pid in chosen_plugins for pid, _, _ in plugin_list}})]
    if model and model != "default":
        out += ["--model", model]
    if set(chosen_mcp) != set(servers) or not keep_connectors:
        os.makedirs(runtime_dir, mode=0o700, exist_ok=True)
        for old in os.listdir(runtime_dir):              # a day is long enough for any session to have read its file
            p = os.path.join(runtime_dir, old)
            try:
                if time.time() - os.path.getmtime(p) > 86400:
                    os.remove(p)
            except OSError:
                pass
        kept = {}
        for pid in chosen_plugins:                        # strict drops plugin servers unless listed
            kept.update(plugin_servers(pid))
        kept.update({n: servers[n] for n in chosen_mcp if n in servers})
        fd, path = tempfile.mkstemp(prefix="mcp-", suffix=".json", dir=runtime_dir)
        with os.fdopen(fd, "w") as f:                    # mkstemp is 0600: server configs carry tokens
            json.dump({"mcpServers": kept}, f)
        out += ["--strict-mcp-config", "--mcp-config", path]
    return out + list(argv)


def whiptail(args):
    """Run a whiptail screen; its answer comes back on stderr. None on cancel."""
    r = subprocess.run(["whiptail", "--title", "claude loadout"] + args, stderr=subprocess.PIPE, text=True)
    return None if r.returncode != 0 else r.stderr.strip()


def fit(s, n):
    s = " ".join((s or "").split())
    return s if len(s) <= n else s[:max(n - 3, 1)] + "..."    # ASCII: renders in any locale


def layout(items):
    """Box sizes from the REAL terminal, and each description cut to what fits
    beside its tag. A fixed 78-column box with 52-char descriptions overflowed:
    a tag like chrome-devtools-mcp@claude-plugins-official is 43 chars alone."""
    cols, lines = shutil.get_terminal_size((80, 24))
    width = max(50, min(cols - 4, 110))
    tagw = max([len(t) for t, _ in items] + [4])
    room = max(width - tagw - 14, 8)                 # checkbox, gaps and borders
    rows = max(3, min(len(items), lines - 12))
    return width, rows, [(t, fit(d, room) or "-") for t, d in items]


def checklist(text, items, on):
    """items: [(tag, description)]; on: tags ticked. Returns ticked tags, or None."""
    width, rows, cut = layout(items)
    args = ["--separate-output", "--checklist", text, str(rows + 9), str(width), str(rows)]
    for t, d in cut:
        args += [t, d, "ON" if t in on else "OFF"]
    got = whiptail(args)
    return None if got is None else [x for x in got.split("\n") if x]


def radiolist(text, items, pick):
    width, rows, cut = layout(items)
    args = ["--radiolist", text, str(rows + 8), str(width), str(rows)]
    for t, d in cut:
        args += [t, d, "ON" if t == pick else "OFF"]
    return whiptail(args)


def interview(cwd, plugin_list, servers):
    cols = shutil.get_terminal_size((80, 24)).columns
    task = whiptail(["--inputbox", "What are you working on? (optional - Enter to skip)", "9",
                     str(max(50, min(cols - 4, 110))), ""])
    if task is None:
        return None
    pick, add = preselect(task, plugin_list)
    # Short tags: the name before @marketplace, unless two plugins share one.
    names = [pid.split("@")[0] for pid, _, _ in plugin_list]
    tag_of = {pid: (n if names.count(n) == 1 else pid) for (pid, _, _), n in zip(plugin_list, names)}
    id_of = {t: pid for pid, t in tag_of.items()}
    items = [(tag_of[pid], ("[Jev: task needs it] " if pid in add else "") + desc) for pid, desc, _ in plugin_list]
    got = checklist("Plugins for this session (space toggles, Enter confirms)", items,
                    {tag_of[pid] for pid, _, on in plugin_list if on or pid in add})
    if got is None:
        return None
    chosen_plugins = [id_of[t] for t in got if t in id_of]
    disabled_hooks = []
    if JEV_HOOKS_ID in chosen_plugins:
        try:
            import jev
            hooks = jev.HOOKS
        except Exception:
            hooks = {}
        if hooks:
            got = checklist("jev-hooks: which hooks run this session", list(hooks.items()), set(hooks))
            if got is None:
                return None
            disabled_hooks = [h for h in hooks if h not in got]
    items = [(CONNECTORS, "Gmail, Drive, Calendar, Docs... (your claude.ai account)")]
    items += [(n, c.get("url") or c.get("command") or c.get("type") or "-") for n, c in sorted(servers.items())]
    got = checklist("MCP servers. Turning ANY off starts strict mode, which also drops the claude.ai "
                    "connectors for this session.", items, {t for t, _ in items})
    if got is None:
        return None
    chosen_mcp = [n for n in got if n != CONNECTORS]
    keep_connectors = CONNECTORS in got and set(chosen_mcp) == set(servers)
    base = default_model()
    try:
        import models
        blurb = {m: models.CRITERIA[m.split("[")[0]].split(":")[0] for m in MODEL_CHOICES}
    except Exception:
        blurb = {m: "" for m in MODEL_CHOICES}
    items = [(base, "your settings default")] + [(m, ("[Jev] " if m == pick else "") + blurb[m])
                                                  for m in MODEL_CHOICES if m != base]
    model = radiolist("Model for this session", items, pick or base)
    if model is None:
        return None
    return chosen_plugins, disabled_hooks, chosen_mcp, keep_connectors, model


def main(argv):
    own, rest, i = {}, [], 0
    while i < len(argv):
        a = argv[i]
        if a in ("--dry-run", "--yes", "--loadout"):
            own[a] = True
        elif a in ("--task", "--pick-plugins", "--pick-hooks", "--pick-mcp", "--pick-model") and i + 1 < len(argv):
            own[a] = argv[i + 1]; i += 1
        else:
            rest.append(a)
        i += 1
    real = shutil.which("claude") or "claude"
    cwd = os.getcwd()
    scripted = own.get("--yes")
    if not scripted and not should_interview(rest, own.get("--loadout")):
        return launch([real] + rest, own)
    plugin_list, servers = plugins(cwd), mcp_servers(cwd)
    if scripted:
        pick, add = preselect(own.get("--task", ""), plugin_list)
        chosen_plugins = own["--pick-plugins"].split(",") if "--pick-plugins" in own else \
            [pid for pid, _, on in plugin_list if on or pid in add]
        try:
            import jev
            hooks = list(jev.HOOKS)
        except Exception:
            hooks = []
        kept = [h for h in own.get("--pick-hooks", ",".join(hooks)).split(",") if h]
        disabled_hooks = [h for h in hooks if h not in kept] if JEV_HOOKS_ID in chosen_plugins else []
        chosen_mcp = [n for n in own["--pick-mcp"].split(",") if n] if "--pick-mcp" in own else list(servers)
        keep_connectors = "--pick-mcp" not in own
        model = own.get("--pick-model") or pick or default_model()
    else:
        if not shutil.which("whiptail"):
            sys.stderr.write("claude-loadout: whiptail not found; starting claude as usual\n")
            return launch([real] + rest, own)
        got = interview(cwd, plugin_list, servers)
        if got is None:                                   # cancelled: normal defaults, no flags
            return launch([real] + rest, own)
        chosen_plugins, disabled_hooks, chosen_mcp, keep_connectors, model = got
    if model == default_model():
        model = "default"
    runtime = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or os.path.join(HOME, ".cache"), "claude-loadout")
    argv2 = build_argv(rest, plugin_list, chosen_plugins, servers, chosen_mcp, keep_connectors, model, runtime)
    argv2[0] = real
    if disabled_hooks:
        # Hooks inherit claude's environment (verified), and each honours
        # JEV_HOOKS_DISABLE. `env` makes the command printed the command run.
        argv2 = ["env", "JEV_HOOKS_DISABLE=" + ",".join(disabled_hooks)] + argv2
    if not own.get("--dry-run"):
        mcp_note = "all" if "--strict-mcp-config" not in argv2 else (", ".join(chosen_mcp) or "none") + " (strict)"
        hooks_note = f" · hooks off: {', '.join(disabled_hooks)}" if disabled_hooks else ""
        sys.stderr.write(f"loadout: model {model} · plugins {', '.join(p.split('@')[0] for p in chosen_plugins) or 'none'}"
                         f"{hooks_note} · mcp {mcp_note}\n")
    return launch(argv2, own)


def launch(argv, own):
    if own.get("--dry-run"):
        print(json.dumps(argv))
        return 0
    os.execv(argv[0], argv) if os.path.isabs(argv[0]) else os.execvp(argv[0], argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
